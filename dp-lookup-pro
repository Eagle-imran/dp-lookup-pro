#!/usr/bin/env uv run python
import sys
import asyncio
import json
from cts_dp_lookup_pro import lookup_plot_pro

def print_usage():
    print("Usage: dp-lookup-pro <VILLAGE_NAME> <CTS_NUMBER> [OUTPUT_DIR]")
    print("Example: dp-lookup-pro BANDRA 100")
    sys.exit(1)

async def main():
    if len(sys.argv) < 3:
        print_usage()
        
    village = sys.argv[1]
    cts_number = sys.argv[2]
    output_dir = sys.argv[3] if len(sys.argv) > 3 else "./output"
    
    print(f"🚀 [PRO] Running DP Spatial Lookup & PDF Report Generation for village '{village}', CTS '{cts_number}'...")
    res = await lookup_plot_pro(village=village, cts_number=cts_number, output_dir=output_dir)
    print("\n" + json.dumps(res, indent=2))

if __name__ == "__main__":
    asyncio.run(main())
